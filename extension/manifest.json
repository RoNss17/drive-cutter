{
  "manifest_version": 3,
  "name": "Drive Cutter",
  "version": "1.0",
  "description": "Cut segments from Google Drive and WeTransfer videos without downloading the full file.",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "cookies"],
  "host_permissions": ["http://127.0.0.1:8000/*", "https://*.google.com/*", "https://*.wetransfer.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/file/d/*/view*",
        "https://drive.google.com/file/d/*/preview*",
        "https://*.wetransfer.com/previews/*",
        "https://*.wetransfer.com/downloads/*",
        "https://wetransfer.com/previews/*",
        "https://wetransfer.com/downloads/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  }
}
